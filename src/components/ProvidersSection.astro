---
import { providers } from "@/lib/providers/registry";

const descriptions: Record<string, string> = {
  "microsoft-gsa":
    "Queries the Microsoft Graph API behind Entra Internet Access web content filtering — the same category Global Secure Access uses to enforce policy.",
};

const plannedProviders = ["FortiGuard", "Cisco Umbrella", "Zscaler", "Netskope"];
---

<section id="providers" class="wrap py-16" aria-labelledby="providers-title">
  <div class="mb-10 max-w-[640px]">
    <h2 id="providers-title" class="text-[28px] font-medium leading-[1.15] tracking-[-0.5px] text-heading sm:text-[36px]">
      Supported providers
    </h2>
    <p class="mt-3 text-[15px] leading-relaxed text-fg">
      Microsoft Global Secure Access is the only provider wired to a real API today, and returns real data whenever
      this deployment has Microsoft Graph credentials configured (deterministic sample data otherwise, so the tool
      still works without a Global Secure Access tenant). Every provider shares the same pluggable interface — see{" "}
      <code class="font-mono text-[13px] text-accent">ARCHITECTURE.md</code>.
    </p>
  </div>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      providers.map((provider) => (
        <a
          href={provider.homepageUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-card border border-transparent bg-bg-elev p-6 transition-[border-color,box-shadow] hover:border-border-strong hover:shadow-[0_4px_16px_rgba(0,0,0,0.25)]"
        >
          <h3 class="text-[16px] font-medium text-heading">{provider.name}</h3>
          <p class="mt-2 text-[14px] leading-relaxed text-fg">{descriptions[provider.slug]}</p>
        </a>
      ))
    }
  </div>

  <p class="mt-6 text-[13px] text-fg-faint">
    Planned, not yet wired up: {plannedProviders.join(", ")}. They'll appear here once real API credentials for one
    of them are available — see the <a href="/about" class="underline hover:text-fg">About</a> page for why we don't
    fake results from a vendor's protected lookup page in the meantime.
  </p>
</section>
