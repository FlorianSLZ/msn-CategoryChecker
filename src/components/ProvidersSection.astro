---
import { providers } from "@/lib/providers/registry";

const descriptions: Record<string, string> = {
  "microsoft-gsa": "Category signal used by Microsoft Entra Internet Access web filtering policies.",
  fortiguard: "FortiGuard Web Filter's category database, used across Fortinet's security portfolio.",
  "cisco-umbrella": "Cisco Umbrella's DNS-layer category intelligence.",
  zscaler: "Zscaler's URL categorization used by its Zero Trust Exchange.",
  netskope: "Netskope's cloud-native web and CASB category classification.",
};
---

<section id="providers" class="wrap py-16" aria-labelledby="providers-title">
  <div class="mb-10 max-w-[640px]">
    <h2 id="providers-title" class="text-[28px] font-medium leading-[1.15] tracking-[-0.5px] text-heading sm:text-[36px]">
      Supported providers
    </h2>
    <p class="mt-3 text-[15px] leading-relaxed text-fg">
      Microsoft Global Secure Access returns real data when this deployment has Microsoft Graph credentials
      configured (sample data otherwise); FortiGuard, Cisco Umbrella, Zscaler, and Netskope are still sample data
      pending real integrations. Every provider shares the same pluggable interface — see
      <code class="font-mono text-[13px] text-accent">ARCHITECTURE.md</code>.
    </p>
  </div>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      providers.map((provider) => (
        <a
          href={provider.homepageUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-card border border-transparent bg-bg-elev p-6 transition-[border-color,box-shadow] hover:border-border-strong hover:shadow-[0_4px_16px_rgba(0,0,0,0.25)]"
        >
          <h3 class="text-[16px] font-medium text-heading">{provider.name}</h3>
          <p class="mt-2 text-[14px] leading-relaxed text-fg">{descriptions[provider.slug]}</p>
        </a>
      ))
    }
  </div>
</section>
