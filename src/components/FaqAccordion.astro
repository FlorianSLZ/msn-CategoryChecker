---
const faqs = [
  {
    question: "What is Microsoft Global Secure Access web content filtering?",
    answer:
      "Web content filtering is a feature of Microsoft Entra Internet Access (part of Global Secure Access) that lets administrators allow or block internet traffic based on the category of the destination website — for example blocking \"Gambling\" or \"Adult Content\" tenant-wide, or blocking \"Social Media\" for specific groups. Those policies only work as intended if the category assigned to a domain matches what the administrator expects.",
  },
  {
    question: "How do I check a website's Global Secure Access category?",
    answer:
      "Type or paste a domain or URL into the search box above and select \"Check Category.\" Category Checker normalizes the input to a bare domain and looks up its Global Secure Access web category, showing the result, status, and when it was checked.",
  },
  {
    question: "Are the results real, live data?",
    answer:
      "When this deployment has Microsoft Graph credentials configured, yes — Category Checker calls the same Microsoft Graph API that Global Secure Access itself uses to categorize a domain. Without those credentials configured, it falls back to deterministic sample data so the tool stays usable for evaluation and demos.",
  },
  {
    question: "What does it mean if a domain shows \"Uncategorized\"?",
    answer:
      "It means Microsoft's web categorization service doesn't currently have a category on file for that domain — this is common for newly registered, low-traffic, or very niche domains. An uncategorized domain isn't necessarily unsafe; it just hasn't been classified yet, which is worth knowing before you write a filtering policy that assumes every domain has a category.",
  },
  {
    question: "Do I need a Global Secure Access license to use Category Checker?",
    answer:
      "No — anyone can use the tool. Whether you see real Microsoft data or sample data depends on whether the person running this deployment has configured Microsoft Graph credentials tied to a tenant with Global Secure Access web content filtering enabled.",
  },
  {
    question: "Is Category Checker free to use?",
    answer:
      "Yes. Category Checker is a free tool from the MSNugget family, with no account or sign-up required.",
  },
  {
    question: "Do you store the domains I check?",
    answer:
      "No lookup history is sent to a server or stored in a database. Recent lookups are kept only in your browser's local storage so you can quickly re-check a domain.",
  },
  {
    question: "Will FortiGuard, Cisco Umbrella, Zscaler, or Netskope be added?",
    answer:
      "Possibly — the provider architecture already supports it. They're not wired up today because each requires either a paid API subscription we don't have, or would mean scraping a vendor's bot-protected public lookup page, which isn't something we're willing to build. See the About page for details.",
  },
  {
    question: "How do I add a real provider integration?",
    answer:
      "Every provider implements the same CategoryProvider interface. Implement checkCategory with an authenticated API call, register any secrets as Cloudflare Worker secrets, and register the provider in the registry — no UI changes are required. src/lib/providers/microsoft-gsa.ts is a working example.",
  },
  {
    question: "Is Category Checker affiliated with Microsoft?",
    answer:
      "No. Category Checker is an independent MSNugget tool. It is not affiliated with, endorsed by, or sponsored by Microsoft or any other provider it queries.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};
---

<section id="faq" class="wrap py-16" aria-labelledby="faq-title">
  <h2 id="faq-title" class="max-w-[640px] text-[28px] font-medium leading-[1.15] tracking-[-0.5px] text-heading sm:text-[36px]">
    Frequently asked questions
  </h2>

  <div class="mt-8 flex max-w-[720px] flex-col gap-3">
    {
      faqs.map((faq) => (
        <details class="group rounded-card border border-border bg-bg-elev p-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-[16px] font-medium text-heading">
            {faq.question}
            <svg
              class="h-4 w-4 shrink-0 text-fg-faint transition-transform duration-200 group-open:rotate-180"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path d="m6 9 6 6 6-6" />
            </svg>
          </summary>
          <p class="mt-3 text-[14px] leading-relaxed text-fg">{faq.answer}</p>
        </details>
      ))
    }
  </div>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqJsonLd)} />
</section>
