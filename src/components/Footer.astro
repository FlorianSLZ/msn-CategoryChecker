---
const year = new Date().getFullYear();
---

<footer class="border-t border-border">
  <div class="wrap flex flex-col gap-8 py-12">
    <div class="flex flex-col items-start justify-between gap-6 border-b border-border pb-8 sm:flex-row sm:items-center">
      <a href="/" class="flex items-center gap-2 text-[13px] font-semibold uppercase tracking-[0.65px]">
        <svg class="h-7 w-7 text-accent" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
          <rect x="1" y="1" width="30" height="30" rx="8" ry="8" fill="currentColor"></rect>
          <path
            d="M16 7l7 3v6c0 5-3.2 8.4-7 9.6C12.2 24.4 9 21 9 16v-6l7-3z"
            fill="none"
            stroke="#ffffff"
            stroke-width="2.2"
            stroke-linejoin="round"></path>
          <path
            d="M12.5 16l2.5 2.5 5-5"
            fill="none"
            stroke="#ffffff"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        <span><span class="text-accent">msnugget</span><span class="text-fg-faint"> &middot; </span><span class="text-heading">category checker</span></span>
      </a>

      <ul class="flex flex-wrap items-center gap-x-6 gap-y-2 text-[13px] font-semibold tracking-[0.5px] text-fg">
        <li><a href="/#providers" class="hover:text-heading">Providers</a></li>
        <li><a href="/#faq" class="hover:text-heading">FAQ</a></li>
        <li><a href="/about" class="hover:text-heading">About</a></li>
        <li><a href="/privacy" class="hover:text-heading">Privacy Policy</a></li>
        <li><a href="/terms" class="hover:text-heading">Terms of Use</a></li>
      </ul>
    </div>

    <div class="flex flex-col gap-2 text-[11px] leading-relaxed text-fg-faint">
      <p>
        Independent project, not affiliated with, endorsed by, or sponsored by Microsoft, Fortinet, Cisco, Zscaler, or Netskope. Their
        product and company names are trademarks of their respective owners.
      </p>
      <p>Category results reflect live Microsoft Graph data where this deployment is configured for it, and illustrative sample data otherwise. Always confirm categorization in the Microsoft Entra admin center before relying on it operationally.</p>
      <p>&copy; {year} Category Checker &middot; part of the <a href="https://msnugget.com/" class="underline hover:text-fg">msnugget</a> family.</p>
    </div>
  </div>
</footer>
