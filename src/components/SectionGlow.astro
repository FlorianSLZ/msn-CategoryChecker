---
// A soft ambient glow bleeding in from one edge of a full-bleed section
// wrapper — atmospheric, not a focal point. See DESIGN.md "Ambient glow".
// The parent section must be `relative overflow-hidden` and NOT itself
// width-constrained by `.wrap`, so the glow can extend to the actual
// viewport edge instead of being clipped to the 1120px content column.
//
// The gradient's center sits exactly on the edge (0%/100%), so only the
// inward half of it is ever visible — a smooth wash flush with the edge,
// not a rounded blob/dot floating near it.
interface Props {
  side: "left" | "right";
}

const { side } = Astro.props;
const position = side === "left" ? "0% 50%" : "100% 50%";
const background = `radial-gradient(560px 420px at ${position}, var(--accent-wash), transparent 70%)`;
---

<div class="pointer-events-none absolute inset-0 -z-10" style={{ background }} aria-hidden="true"></div>
