# Analytics — pick one provider, or leave unset for no analytics.
# PUBLIC_ANALYTICS_PROVIDER=plausible | umami | none
PUBLIC_ANALYTICS_PROVIDER=none

# Plausible (used when PUBLIC_ANALYTICS_PROVIDER=plausible)
PUBLIC_PLAUSIBLE_DOMAIN=categorychecker.msnugget.com
PUBLIC_PLAUSIBLE_SCRIPT_URL=https://plausible.io/js/script.js

# Umami (used when PUBLIC_ANALYTICS_PROVIDER=umami)
PUBLIC_UMAMI_SCRIPT_URL=https://umami.example.com/script.js
PUBLIC_UMAMI_WEBSITE_ID=

# Feature flags
PUBLIC_FEATURE_RECENT_LOOKUPS=true

# Real provider credentials are Cloudflare Worker secrets, NOT Vite env vars
# — they don't belong in this file. See .dev.vars.example for local dev and
# ARCHITECTURE.md / README.md for how to set them in production. Leave them
# unset to keep using the built-in mock providers (each falls back
# automatically when its credentials aren't configured).
